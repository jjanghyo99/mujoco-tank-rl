<mujoco model="tank_minimal">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <geom friction="1.0 0.005 0.0001" contype="1" conaffinity="1"
        solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>

  <worldbody>
    <!-- 조명 및 바닥 -->
    <light diffuse="0.8 0.8 0.8" pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>

    <!-- 탱크 몸체: freejoint로 자유롭게 움직이게 -->
    <body name="tank_body" pos="0 0 0.08">
      <freejoint/>
      <geom name="tank_geom" type="box" size="0.2 0.15 0.08"
            rgba="0.2 0.6 0.2 1" mass="5"/>
    </body>

    <!-- 장애물 테스트용 박스 -->
    <body name="obstacle1" pos="2 0 0.15">
      <geom type="box" size="0.15 0.15 0.15" rgba="0.6 0.2 0.2 1"/>
    </body>
  </worldbody>
</mujoco>