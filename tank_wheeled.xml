<mujoco model="tank_wheeled">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <geom friction="1.0 0.005 0.0001" contype="1" conaffinity="1"
          solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </default>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="tank_body" pos="0 0 0.1">
    <freejoint/>
    <geom name="tank_geom" type="box" size="0.2 0.13 0.08" rgba="0.2 0.6 0.2 1" mass="4"/>

    <!-- 왼쪽 바퀴: 몸체 폭(0.13) 안쪽으로 배치 -->
    <body name="left_wheel" pos="0 0.17 -0.05">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.3"/>
        <geom type="cylinder" size="0.05 0.02" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="0.3"/>
    </body>

    <body name="right_wheel" pos="0 -0.17 -0.05">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.3"/>
        <geom type="cylinder" size="0.05 0.02" euler="90 0 0" rgba="0.1 0.1 0.1 1" mass="0.3"/>
    </body>

        <!-- 앞쪽 캐스터 -->
    <body name="caster_front" pos="0.19 0 -0.08">
      <geom type="sphere" size="0.02" rgba="0.3 0.3 0.3 1" mass="0.05"
            friction="0.05 0.005 0.0001"/>
    </body>

    <!-- 뒤쪽 캐스터 -->
    <body name="caster_rear" pos="-0.19 0 -0.08">
      <geom type="sphere" size="0.02" rgba="0.3 0.3 0.3 1" mass="0.05"
            friction="0.05 0.005 0.0001"/>
    </body>

    </body>

    <body name="obstacle1" pos="2 0 0.15">
      <geom type="box" size="0.15 0.15 0.15" rgba="0.6 0.2 0.2 1"/>
    </body>
  </worldbody>

  <contact>
    <exclude body1="tank_body" body2="left_wheel"/>
    <exclude body1="tank_body" body2="right_wheel"/>
    <exclude body1="tank_body" body2="caster_front"/>
    <exclude body1="tank_body" body2="caster_rear"/>
  </contact>

  <actuator>
    <motor joint="left_wheel_joint" ctrlrange="-5 5" gear="1"/>
    <motor joint="right_wheel_joint" ctrlrange="-5 5" gear="1"/>
  </actuator>
</mujoco>